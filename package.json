{
  "name": "foundation-workbench",
  "version": "0.47.0",
  "private": true,
  "type": "module",
  "description": "Foundation Code OSS desktop host and connected product workspace",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:api": "node server/index.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "desktop:bootstrap": "node desktop/scripts/bootstrap.mjs",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:bundle": "node desktop/scripts/bundle-extension.mjs",
    "desktop:launch": "node desktop/scripts/launch.mjs",
    "desktop:test": "node --test desktop/tests/*.test.mjs desktop/extension/test/*.test.mjs",
    "desktop:check": "tsc -p desktop/extension/tsconfig.json",
    "desktop:smoke": "node desktop/scripts/smoke.mjs",
    "desktop:refresh": "node desktop/scripts/install-extension.mjs",
    "desktop:dev": "node desktop/scripts/develop.mjs",
    "desktop:history-smoke": "node desktop/scripts/conversation-smoke.mjs",
    "desktop:benchmark": "node desktop/scripts/benchmark.mjs",
    "desktop:feature-smoke": "node desktop/scripts/feature-smoke.mjs",
