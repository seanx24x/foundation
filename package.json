    "desktop:execution-smoke": "node desktop/scripts/execution-smoke.mjs",
    "desktop:request-revision-smoke": "node desktop/scripts/request-revision-smoke.mjs",
    "desktop:group-revision-smoke": "node desktop/scripts/group-revision-smoke.mjs",
    "desktop:check-plan-smoke": "node desktop/scripts/check-plan-smoke.mjs",
    "desktop:check-suggestion-smoke": "node desktop/scripts/check-suggestion-smoke.mjs",
