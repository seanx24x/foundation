    "desktop:visual-capture-smoke": "node desktop/scripts/visual-capture-smoke.mjs",
    "desktop:scenario-replay-smoke": "node desktop/scripts/scenario-replay-smoke.mjs",
    "desktop:condition-matrix-smoke": "node desktop/scripts/condition-matrix-smoke.mjs",
    "desktop:state-suite-smoke": "node desktop/scripts/state-suite-smoke.mjs",
    "desktop:change-impact-smoke": "node desktop/scripts/change-impact-smoke.mjs",
    "desktop:visual-verification-smoke": "node desktop/scripts/visual-verification-smoke.mjs",
    "desktop:visual-alternatives-smoke": "node desktop/scripts/visual-alternatives-smoke.mjs",
    "desktop:alternative-adoption-smoke": "node desktop/scripts/alternative-adoption-smoke.mjs",
    "desktop:scoped-multi-file-alternatives-smoke": "node desktop/scripts/scoped-multi-file-alternatives-smoke.mjs",
