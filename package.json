  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "lucide-react": "0.576.0",
    "monaco-editor": "0.57.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "postcss": "8.5.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
