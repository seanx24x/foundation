  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9DA7B8",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CAA7EF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9DD6B6"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E7BC82"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#CAA7EF"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#A0C2FF"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#F2F2F4"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A0C2FF"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#CAA7EF"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C2C2CB"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F2F2F4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#90DBAE"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FFACB7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FFACB7"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E7BC82"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C2C2CB",
    "type": "#CAA7EF",
    "class": "#CAA7EF",
    "enum": "#CAA7EF",
    "interface": "#CAA7EF",
    "struct": "#CAA7EF",
    "typeParameter": "#CAA7EF",
    "parameter": "#F2F2F4",
    "variable": "#F2F2F4",
    "property": "#F2F2F4",
    "enumMember": "#E7BC82",
    "event": "#A0C2FF",
    "function": "#A0C2FF",
    "method": "#A0C2FF",
    "macro": "#A0C2FF",
    "keyword": "#CAA7EF",
    "modifier": "#CAA7EF",
    "comment": "#9DA7B8",
    "string": "#9DD6B6",
    "number": "#E7BC82",
    "regexp": "#9DD6B6",
    "operator": "#C2C2CB",
    "decorator": "#A0C2FF",
    "variable.readonly": "#E7BC82",
    "property.readonly": "#E7BC82"
  }
}
