export interface RuntimeSnapshot { status:'idle'|'starting'|'connecting'|'connected'|'disconnected'|'error'; root:string; targets:RuntimeTarget[]; owned:boolean; target?:RuntimeTarget;session?:string;viewId?:string;targetUrl?:string;url?:string;error?:string;version?:number;pageConnected?:boolean;pagePath?:string|null;documentId?:string|null;pageVersion?:number|null;capabilities:{sourceMapping:'instrumented'|'unavailable';requests:boolean;screenshots:boolean;routeTracking?:boolean;scenarioReplay?:boolean};replayCatalog?:ReplayCatalog|null;replayBlocked?:'reload-required'|'invalid-catalog'|null;selection:RuntimeSelection|null;selectionVersion:number;observations:RuntimeObservation[];files:{path:string;revision:string}[]; }
