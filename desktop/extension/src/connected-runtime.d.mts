export function createConnectedRuntime(options:{root:string;onChange?:(snapshot:RuntimeSnapshot)=>void;nodePath?:string;pollMs?:number;startupTimeoutMs?:number;launchProcess?:(request:{root:string;nodePath:string;args:string[];token:string})=>ChildProcess|Promise<ChildProcess>}):{discover():Promise<RuntimeTarget[]>;start(targetId?:string):Promise<RuntimeSnapshot>;connect(url:string):Promise<RuntimeSnapshot>;navigate(route:string):Promise<RuntimeSnapshot>;stop():Promise<void>;snapshot():RuntimeSnapshot;readCurrent():Promise<RuntimeSnapshot>;replay(input:ReplayRequest,options?:{signal?:AbortSignal;onProgress?:(progress:ReplayProgress)=>PromiseLike<void>|void}):Promise<ReplayResult>;cancelReplay(executionId?:string):Promise<void>;dispose():Promise<void>};

export interface ReplayRecipe {id:string;title:string;route:string;fixture:{id:string;label:string};steps:{id:string;title:string}[]}
