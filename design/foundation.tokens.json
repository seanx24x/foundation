{
  "version": "1.3.0",
  "status": "Design contract; not yet applied to the desktop app",
  "date": "2026-10-27",
  "unit": "logical CSS px; native macOS dimensions in points",
  "grid": 4,
  "space": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64,
    80,
    96
  ],
  "radius": {
    "flush": 0,
    "small": 4,
    "control": 8,
    "overlay": 12,
    "stage": 16
  },
  "font": {
    "ui": "Geist",
    "code": "Geist Mono",
    "fallbackUI": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "fallbackCode": "SFMono-Regular, Consolas, monospace",
    "weights": [
      400,
      500,
      600
    ]
  },
  "density": {
    "standard": {
      "row": 32,
      "control": 32,
      "sectionHeader": 32,
      "treeIndent": 16,
      "itemGap": 8
    },
    "compact": {
      "row": 28,
      "control": 28,
      "sectionHeader": 28,
      "treeIndent": 16,
      "itemGap": 4
    },
    "coarse": {
      "row": 44,
      "control": 44,
      "sectionHeader": 32,
      "treeIndent": 16,
      "itemGap": 8
    }
  },
  "layout": {
    "window": {
      "defaultWidth": 1440,
      "defaultHeight": 960,
      "fullMinimumWidth": 1024,
      "fullMinimumHeight": 640,
      "narrowFallbackWidth": 800,
      "narrowFallbackHeight": 600
    },
    "titlebar": 48,
    "workflowbar": 0,
    "tabbar": 40,
    "statusbar": 24,
    "rail": 48,
    "navigator": {
      "default": 240,
      "min": 192,
      "max": 360
    },
    "inspector": {
      "default": 320,
      "min": 280,
      "max": 480
    },
    "assistant": {
      "default": 384,
      "min": 320,
      "max": 560
    },
    "center": {
      "min": 480,
      "splitPaneMin": 384
    },
    "bottom": {
      "default": 240,
      "min": 160,
      "max": 480,
      "remainingMainMin": 320
    },
    "resizeHitArea": 8,
    "resizeStep": 4,
    "resizeLargeStep": 16,
    "dialog": {
      "small": 400,
      "default": 560,
      "large": 720
    },
    "commandPalette": 640,
    "tooltipMax": 320
  },
  "motion": {
    "immediate": 0,
    "hover": 80,
    "disclosure": 120,
    "panel": 160,
    "workspace": 220,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": 0
  },
  "gridExceptions": [
    "1px separator and icon stroke geometry",
    "2px focus stroke and 2px offset",
    "optical font size, tracking, glyph and baseline metrics",
    "native OS window frame/traffic lights",
    "user editor configuration and existing panel state",
    "0-3px flexible-center remainder at arbitrary host sizes",
    "continuous pointer/zoom coordinates before snap",
    "external product geometry, runtime measurements, third-party extensions"
  ],
